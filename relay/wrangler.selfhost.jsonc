{
  // ★★ **Your own relay** (2026-09-25). Deploy with:  npx wrangler deploy -c wrangler.selfhost.jsonc
  //   Then on each PC set "relayUrl" in ~/.nyan-remote/config.json to wss://<name>.<your-subdomain>.workers.dev
  //   (or your own domain) and restart the agent.
  //
  // ⚠️ `wrangler.jsonc` next to this is **our production relay** (our account, our domain, our plans) — do not use it.
  //   What this file leaves out on purpose:
  //   - `account_id`  ⇒ wrangler uses the account you are logged in to
  //   - `routes`      ⇒ served on workers.dev (add your own custom domain if you like)
  //   And it adds `SELF_HOSTED` ⇒ **no plans**: a signed-in PC's ticket is not asked for, phones are not asked to prove
  //   their key, rooms take up to 8 phones and no free-tier count is kept
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyan-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  // ⚠️ Per-version preview URLs would add public entry points running old code
  "preview_urls": false,
  "workers_dev": true,
  "observability": { "enabled": true },
  // ★★ No plans on your own relay: tickets are never asked for, every room takes up to 8 phones (`selfHosted` in src/room.ts)
  "vars": { "SELF_HOSTED": "1" },
  "durable_objects": {
    "bindings": [
      { "name": "RENDEZVOUS", "class_name": "Rendezvous" },
      // ★ Only used with plans (never on a self-hosted relay), but the classes are exported by the worker, so they stay bound
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      { "name": "PHONES", "class_name": "Phones" }
    ]
  },
  // ⚠️ SQLite backend (the one available on the free plan)
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Rendezvous"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts"] },
    { "tag": "v3", "new_sqlite_classes": ["Phones"] }
  ]
}
